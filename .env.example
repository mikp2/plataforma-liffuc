# PostgreSQL local (docker compose o instalación nativa)
DATABASE_URL="postgresql://banco:banco@localhost:5432/banco_moleculas?schema=public"
# Prisma uses the direct Neon URL for migrations; use the local URL for both locally.
DATABASE_URL_UNPOOLED="postgresql://banco:banco@localhost:5432/banco_moleculas?schema=public"

# NextAuth y enlaces de correo: usa la URL pública accesible de la app.
# En Codespaces: https://<CODESPACE_NAME>-3000.<FORWARDING_DOMAIN>
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esta-clave-en-local-y-en-produccion"

# Administrador inicial creado por `npm run db:seed`
ADMIN_NAME="Administrador LIFFUC"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="usa-contraseñas-seguras-en-producción"

# Gmail SMTP para enviar confirmaciones de registro de visitantes.
# Requiere verificación en dos pasos y una contraseña de aplicación de Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASSWORD="contraseña-de-aplicación-de-16-caracteres"
SMTP_FROM="LIFFUC-DB <tu-cuenta@gmail.com>"
